# Application
NODE_ENV=development
PORT=3000
VITE_APP_TITLE=Alsatbedava.com
VITE_APP_LOGO=/logo.png

# MySQL
DATABASE_URL=mysql://user:password@localhost:3306/alsatbedava

# Authentication
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
# The account registered with this address becomes an administrator.
ADMIN_EMAIL=admin@example.com

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, Backblaze B2, etc.)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=alsatbedava
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=auto
S3_PUBLIC_URL=http://localhost:9000/alsatbedava

# Optional email service
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=notifications@alsatbedava.com
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=notifications@alsatbedava.com

# Optional monitoring
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# SENTRY_DSN=

# Optional scheduled jobs
# ENABLE_EMAIL_NOTIFICATIONS=true
# ENABLE_SCHEDULER=true
