# Alsatbedava.com - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===== Database Configuration =====
# MySQL/TiDB connection string
# Format: mysql://username:password@host:port/database_name
DATABASE_URL=mysql://user:password@localhost:3306/alsatbedava

# ===== Authentication (OAuth) =====
# JWT secret for session signing (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# OAuth authorization URL used by the frontend login button
VITE_OAUTH_AUTHORIZE_URL=https://auth.example.com/oauth/authorize

# OAuth client ID, exposed to the frontend
VITE_OAUTH_CLIENT_ID=your-oauth-client-id

# OAuth token and userinfo endpoints used by the backend callback
OAUTH_TOKEN_URL=https://auth.example.com/oauth/token
OAUTH_USERINFO_URL=https://auth.example.com/oauth/userinfo
OAUTH_CLIENT_SECRET=your-oauth-client-secret
VITE_OAUTH_SCOPE=openid profile email

# ===== S3 Storage Configuration =====
# S3-compatible storage endpoint
S3_ENDPOINT=https://your-s3-endpoint.com
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_REGION=auto
S3_PUBLIC_URL=https://cdn.example.com

# ===== Application Configuration =====
# Environment: development or production
NODE_ENV=development

# Server port (default: 3000)
PORT=3000

# Temporary friend testing without production OAuth, database, or S3.
# Do not leave this enabled for a real public launch.
DEMO_MODE=false

# Application title (displayed in browser)
VITE_APP_TITLE=Alsatbedava.com

# Application logo path
VITE_APP_LOGO=/logo.png

# ===== Owner Configuration =====
# OAuth OpenID/sub claim that should receive admin access
OWNER_OPEN_ID=your-owner-open-id

# ===== Email Service (Optional - Choose One) =====
# Uncomment and configure the email service you want to use

# SendGrid (Recommended)
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=notifications@alsatbedava.com

# AWS SES
# AWS_SES_REGION=eu-west-1
# AWS_SES_ACCESS_KEY=your-aws-access-key
# AWS_SES_SECRET_KEY=your-aws-secret-key
# AWS_SES_FROM_EMAIL=notifications@alsatbedava.com

# Resend
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM_EMAIL=notifications@alsatbedava.com

# ===== Analytics & Monitoring (Optional) =====
# Google Analytics tracking ID
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN for error monitoring
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===== Feature Flags (Optional) =====
# Enable/disable automated email notifications
# ENABLE_EMAIL_NOTIFICATIONS=true

# Enable/disable scheduled cron jobs
# ENABLE_SCHEDULER=true
